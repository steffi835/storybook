{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "declarationDir": "./dist/types",
    "rootDir": "./src"
  },
  "include": [
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/index.ts"
  ],
  "exclude": [
    "src/stories/**",
    "src/**/*.stories.*",
    "src/App.tsx",
    "src/main.tsx"
  ]
}